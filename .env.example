# Compulife API (Section 7). Only one server IP is authorized per ID —
# confirm the deployment host with Compulife before going live, see the
# comment at the top of app/api/quote/route.ts.
COMPULIFE_AUTHORIZATION_ID=

# Fixed-IP relay (compulife-proxy/, deployed separately on Railway). Leave
# both unset to call Compulife directly (local dev only — Vercel's outbound
# IP is not stable).
# COMPULIFE_PROXY_URL=
# COMPULIFE_PROXY_SECRET=

# Populated in a later phase (Supabase migration, Meta Lead Ads, Resend).
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# META_APP_SECRET=
# META_VERIFY_TOKEN=
# META_PAGE_ACCESS_TOKEN=
# RESEND_API_KEY=
# NOTIFY_EMAILS=
# CRON_SECRET=
