# Compulife API (Section 7). Only one server IP is authorized per ID —
# confirm the deployment host with Compulife before going live, see the
# comment at the top of app/api/quote/route.ts.
#
# Production: set COMPULIFE_API_URL to api.php hosted on the client's
# WordPress server (fixed IP), e.g. https://firstavefinancial.com/compulifeapi/api.php
# — the Authorization ID lives in that server's config.php, not here.
COMPULIFE_API_URL=

# Local dev only fallback — calls Compulife directly (Vercel's outbound IP
# is not stable, so this must stay unset in production).
COMPULIFE_AUTHORIZATION_ID=

# Populated in a later phase (Supabase migration, Meta Lead Ads, Resend).
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# META_APP_SECRET=
# META_VERIFY_TOKEN=
# META_PAGE_ACCESS_TOKEN=
# RESEND_API_KEY=
# NOTIFY_EMAILS=
# CRON_SECRET=
